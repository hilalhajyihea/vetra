# Environment
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vetra"
AUTH_SECRET="replace-with-long-random-secret"
PLATFORM_USERNAME="admin"
PLATFORM_PASSWORD="replace-with-strong-password"

APP_URL="https://vetra.onrender.com"
NEXT_PUBLIC_SITE_URL="https://vetra.onrender.com"

# Same value as Meta / Dualhook "Verify Token". Required for WhatsApp webhook handshake.
WHATSAPP_VERIFY_TOKEN="replace-with-a-long-random-token"

# Meta Cloud API (preferred). If WHATSAPP_ACCESS_TOKEN is set, Dualhook is not used.
WHATSAPP_ACCESS_TOKEN="EAAG-replace-with-system-user-token"
WHATSAPP_PHONE_NUMBER_ID="replace-with-phone-number-id"
WHATSAPP_TEMPLATE_NAME="vetra_notice"
WHATSAPP_TEMPLATE_LANGUAGE="he"
WHATSAPP_TEMPLATE_BODY_PARAMS="1"

# Dualhook fallback (used only when WHATSAPP_ACCESS_TOKEN is empty)
DUALHOOK_API_KEY="dh_live_replace_me"
DUALHOOK_PHONE_NUMBER_ID="replace-with-phone-number-id"
DUALHOOK_TEMPLATE_NAME="vetra_notice"
DUALHOOK_TEMPLATE_LANGUAGE="he"
DUALHOOK_TEMPLATE_BODY_PARAMS="1"
