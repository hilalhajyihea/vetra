# Environment
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vetra"
AUTH_SECRET="replace-with-long-random-secret"
PLATFORM_USERNAME="admin"
PLATFORM_PASSWORD="replace-with-strong-password"

APP_URL="https://vetra.onrender.com"
NEXT_PUBLIC_SITE_URL="https://vetra.onrender.com"

# Same value as Dualhook "Verify Token". Required for WhatsApp webhook handshake.
WHATSAPP_VERIFY_TOKEN="replace-with-a-long-random-token"
