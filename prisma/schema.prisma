generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Veterinarian {
  id           String   @id @default(cuid())
  slug         String   @unique
  displayName  String
  clinicName   String?
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  /// Public + vet UI language: he | ar
  locale       String   @default("he")
  phone        String?
  /// BASE | CUSTOM
  plan         String   @default("BASE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  breeders Breeder[]
}

model Breeder {
  id              String    @id @default(cuid())
  veterinarianId  String
  firstName       String
  lastName        String
  farmName        String
  /// Normalized local Israeli mobile, e.g. 0501234567
  phone           String
  email           String
  passwordHash    String
  /// PENDING | APPROVED | REJECTED
  status          String    @default("PENDING")
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  veterinarian Veterinarian @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)

  @@unique([veterinarianId, phone])
  @@index([veterinarianId, status])
}
