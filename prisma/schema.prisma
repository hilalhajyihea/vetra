generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Veterinarian {
  id           String   @id @default(cuid())
  slug         String   @unique
  displayName  String
  clinicName   String?
  username     String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  /// Public + vet UI language: he | ar
  locale       String   @default("he")
  phone        String?
  /// BASE | CUSTOM
  plan         String   @default("BASE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  breeders    Breeder[]
  vaccineTypes VaccineType[]
}

model Breeder {
  id              String    @id @default(cuid())
  veterinarianId  String
  firstName       String
  lastName        String
  farmName        String
  /// Normalized local Israeli mobile, e.g. 0501234567
  phone           String
  email           String
  passwordHash    String
  /// PENDING | APPROVED | REJECTED
  status          String    @default("PENDING")
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  veterinarian Veterinarian @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)
  groups       AnimalGroup[]
  animals      Animal[]

  @@unique([veterinarianId, phone])
  @@index([veterinarianId, status])
}

model AnimalGroup {
  id        String   @id @default(cuid())
  breederId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breeder Breeder  @relation(fields: [breederId], references: [id], onDelete: Cascade)
  animals Animal[]

  @@index([breederId])
}

model Animal {
  id        String   @id @default(cuid())
  breederId String
  groupId   String
  /// Unique tag / number within this farm
  number    String
  /// MALE | FEMALE
  sex       String
  birthDate DateTime @db.Date
  pregnant  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breeder      Breeder             @relation(fields: [breederId], references: [id], onDelete: Cascade)
  group        AnimalGroup         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  vaccinations AnimalVaccination[]

  @@unique([breederId, number])
  @@index([breederId])
  @@index([groupId])
}

model VaccineType {
  id             String   @id @default(cuid())
  veterinarianId String
  name           String
  description    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  veterinarian Veterinarian        @relation(fields: [veterinarianId], references: [id], onDelete: Cascade)
  records      AnimalVaccination[]

  @@unique([veterinarianId, name])
  @@index([veterinarianId])
}

model AnimalVaccination {
  id            String   @id @default(cuid())
  animalId      String
  vaccineTypeId String?
  name          String
  validUntil    DateTime @db.Date
  createdAt     DateTime @default(now())

  animal      Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  vaccineType VaccineType? @relation(fields: [vaccineTypeId], references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([vaccineTypeId])
}
